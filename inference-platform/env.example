# Copy to .env only if you need to override these defaults.
# Environment variables take precedence. Relative paths use the project root.
# Stage 1 is local only: host must remain 127.0.0.1.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=5000
INFERENCE_DATABASE_PATH=runtime/db/platform.sqlite3
INFERENCE_LOG_DIR=runtime/logs
INFERENCE_LOG_LEVEL=INFO
# Stage 3: managed audio objects; clients cannot supply server paths.
INFERENCE_UPLOAD_DIR=runtime/uploads

# Stage 2: explicitly prepare the pinned multilingual small model first.
# Transcription loads only this local directory; it never downloads models.
INFERENCE_ASR_MODEL_DIR=runtime/models/whisper-small
INFERENCE_ASR_MODEL_REPO=Systran/faster-whisper-small
INFERENCE_ASR_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
INFERENCE_ASR_DEVICE=cpu
INFERENCE_ASR_COMPUTE_TYPE=int8
INFERENCE_ASR_CPU_THREADS=4
# Development admission limits; you may lower them for validation.
INFERENCE_ASR_MAX_FILE_BYTES=20971520
INFERENCE_ASR_MAX_AUDIO_SECONDS=300

# ASR-4A: OPTIONAL Remote-V2 SenseVoice synchronous file endpoint.
# Keep the TWO required identity/address keys commented until actual values are confirmed.
# HTTPS service root only (no API path, user info, query or fragment).
# Upstream model/deployment version is optional; API version 14.2 is NOT that version.
# INFERENCE_REMOTE_ASR_BASE_URL=https://your-asr-server:8003
# INFERENCE_REMOTE_ASR_MODEL_ID=your-sensevoice-model-id
# Omit or leave blank when unknown. A stable local integration revision will identify
# this connection configuration; it does not claim the upstream model is pinned.
# INFERENCE_REMOTE_ASR_MODEL_VERSION=your-fixed-deployment-version
# Certificate verification is enabled by default; optionally provide a trusted CA.
# INFERENCE_REMOTE_ASR_CA_FILE=runtime/certificates/asr-ca.pem
# Only after explicit authorization: skip verification for this exact HTTPS origin.
# Disabled by default; no path/wildcard, must match BASE_URL, cannot coexist with CA_FILE.
# A changed address requires a matching explicit origin; this never follows redirects.
# INFERENCE_REMOTE_ASR_INSECURE_TLS_ORIGIN=https://your-asr-server:8003
# No authentication scheme is invented; clarify any credentials before real integration.
# Register/enable the exact exported spec explicitly after validating the configuration.
# A running remote call cannot be cancelled or automatically retransmitted.
INFERENCE_REMOTE_ASR_CONNECT_TIMEOUT_SECONDS=5
INFERENCE_REMOTE_ASR_TOTAL_TIMEOUT_SECONDS=600
# 新路由默认关闭。本机-2B仅允许独立临时目录及回环服务隔离验证；日常不要设置修订。
# INFERENCE_REMOTE_ASR_ROUTING_REVISION=<64位已登记修订>
INFERENCE_REMOTE_ASR_ROUTING_ISOLATION=false

# Stage 9: local single-image YOLOv5n ONNX; prepare explicitly, then run offline.
INFERENCE_VISION_MODEL_DIR=runtime/models/yolov5n-onnx
INFERENCE_VISION_CPU_THREADS=4
# JPEG/PNG only; both encoded bytes and decoded pixels must fit. May be lowered.
INFERENCE_VISION_MAX_FILE_BYTES=10485760
INFERENCE_VISION_MAX_PIXELS=20000000

# Offline channel: ASR and Vision each have one independent worker / execution slot.
INFERENCE_LEASE_SECONDS=30
INFERENCE_RENEW_INTERVAL_SECONDS=10
INFERENCE_NOTIFICATION_VISIBILITY_SECONDS=30
INFERENCE_RUNTIME_HEARTBEAT_SECONDS=2
INFERENCE_RUNTIME_STALE_SECONDS=15
INFERENCE_POLL_INTERVAL_SECONDS=0.25
INFERENCE_DISPATCH_RETRY_SECONDS=5
INFERENCE_WORKER_STARTUP_TIMEOUT_SECONDS=120
INFERENCE_WORKER_STOP_TIMEOUT_SECONDS=10

# Stage 6: fixed acceptance deadlines; attempts include the first execution.
# Offline and online active requests share this admission limit, not a capacity benchmark.
INFERENCE_MAX_INFLIGHT_TASKS=20
INFERENCE_QUEUE_TIMEOUT_SECONDS=600
INFERENCE_ATTEMPT_TIMEOUT_SECONDS=900
INFERENCE_TOTAL_TIMEOUT_SECONDS=1800
INFERENCE_MAX_ATTEMPTS=2
INFERENCE_RETRY_WAIT_SECONDS=5

# Stage 12: OPTIONAL static text-only Chat Completions service.
# No real LLM service is configured or verified on this computer.
# Leave ALL FOUR identity/endpoint keys commented unless a real service is provided.
# They must be configured together; do not copy placeholder values into a working .env.
# Use a complete HTTP(S) /v1/chat/completions URL, without credentials/query/fragment.
# INFERENCE_LLM_ENDPOINT=http://your-server:8000/v1/chat/completions
# INFERENCE_LLM_MODEL_ID=your-platform-model-id
# INFERENCE_LLM_MODEL_VERSION=your-fixed-deployment-version
# INFERENCE_LLM_UPSTREAM_MODEL=the-exact-name-served-by-the-engine
# Optional secret, only in local .env or environment; never in the frontend or registry spec.
# INFERENCE_LLM_API_KEY=your-private-key
# After configuration, export the exact spec, register/enable/set-default explicitly.
# This neither starts a model server nor verifies real model output.
INFERENCE_LLM_MAX_CONCURRENT_REQUESTS=1
INFERENCE_LLM_ADMISSION_WAIT_SECONDS=2
INFERENCE_LLM_CONNECT_TIMEOUT_SECONDS=5
INFERENCE_LLM_READ_TIMEOUT_SECONDS=30
INFERENCE_LLM_TOTAL_TIMEOUT_SECONDS=120
INFERENCE_LLM_SLOW_CONSUMER_SECONDS=5
INFERENCE_LLM_LEASE_SECONDS=15
# 仅保护本机 ASR 启停写接口，不代表完整账户鉴权。留空时使用本机 agent_cli。
# 配置后重启 API；使用至少32字符随机令牌，通过 X-Management-Token 发送，勿提交到仓库。
# INFERENCE_AGENT_TOKEN=replace-with-a-random-token-at-least-32-characters
